<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingsView"
             x:DataType="vm:BorrowingsViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="Active Borrowings" Classes="heading" Margin="0,0,0,10"/>

        <ListBox Grid.Row="1" ItemsSource="{Binding ActiveBorrowings}" SelectedItem="{Binding SelectedBorrowing}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding BorrowingId}" Width="40"/>
                        <TextBlock Text="{Binding StudentName}" Width="140"/>
                        <TextBlock Text="{Binding EquipmentName}" Width="160"/>
                        <TextBlock Text="{Binding DateBorrowed, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                        <TextBlock Text="{Binding ExpectedReturnDate, StringFormat={}{0:yyyy-MM-dd}}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Margin="0,10,0,0" Spacing="6">
            <Button Content="Return Equipment" Command="{Binding ReturnCommand}" HorizontalAlignment="Stretch"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="Orange"/>
        </StackPanel>
    </Grid>
</UserControl>
