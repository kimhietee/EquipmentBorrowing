<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:domain="using:EquipmentBorrowing.Domain"
             x:Class="EquipmentBorrowing.Desktop.Views.EquipmentView"
             x:DataType="vm:EquipmentViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12">
                <CheckBox Content="Available only" IsChecked="{Binding ShowOnlyAvailable}" VerticalAlignment="Center"/>
                <Button Content="Refresh" Command="{Binding LoadCommand}"/>
            </StackPanel>
            <TextBlock Text="Equipment Catalog" Classes="heading" Margin="0"/>
        </DockPanel>

        <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,8">
            <TextBlock Text="Loading equipment catalog..." IsVisible="{Binding IsLoading}" FontStyle="Italic"/>
            <Border IsVisible="{Binding HasError}" Background="#5A2A27" CornerRadius="4" Padding="8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Retry" Command="{Binding LoadCommand}" Margin="8,0,0,0"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
            <Border IsVisible="{Binding IsEmpty}" Background="#2B2B2B" CornerRadius="4" Padding="8">
                <TextBlock Text="{Binding EmptyMessage}" Foreground="LightGray"/>
            </Border>
        </StackPanel>

        <ListBox Grid.Row="2" ItemsSource="{Binding EquipmentList}" SelectedItem="{Binding SelectedEquipment}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="domain:Equipment">
                    <Grid ColumnDefinitions="90,170,*,90" Margin="2">
                        <TextBlock Grid.Column="0" Text="{Binding Identifier}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{Binding Description, TargetNullValue='—'}" Foreground="Gray" TextTrimming="CharacterEllipsis" Margin="8,0"/>
                        <TextBlock Grid.Column="3" Text="{Binding IsAvailable, StringFormat='Available: {0}'}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="3" ColumnDefinitions="*,16,*" Margin="0,12,0,0">
            <Border Grid.Column="0" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Padding="10">
                <StackPanel Spacing="6">
                    <TextBlock Text="Borrow Selected Item (Single)" FontWeight="Bold"/>
                    <ComboBox ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}"
                              PlaceholderText="Select student" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="domain:Student">
                                <TextBlock>
                                    <Run Text="{Binding StudentNumber}"/>
                                    <Run Text=" - "/>
                                    <Run Text="{Binding Name}"/>
                                    <Run Text=" (Eligible: "/>
                                    <Run Text="{Binding IsAllowedToBorrow}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Expected Return Date" FontSize="12" Foreground="Gray"/>
                    <DatePicker SelectedDate="{Binding ExpectedReturnDate}" HorizontalAlignment="Stretch"/>
                    <Button Content="Borrow Equipment" Command="{Binding BorrowCommand}" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Padding="10">
                <StackPanel Spacing="6">
                    <TextBlock Text="Register or Edit Equipment" FontWeight="Bold"/>
                    <TextBox PlaceholderText="Identifier (e.g. EQ-007)" Text="{Binding EquipmentIdentifierInput}"/>
                    <TextBox PlaceholderText="Equipment name" Text="{Binding EquipmentNameInput}"/>
                    <TextBox PlaceholderText="Optional description (blank clears)" Text="{Binding EquipmentDescriptionInput}"/>
                    <TextBlock Text="{Binding SelectedAvailabilityDisplay}" FontSize="12" Foreground="Gray"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Register New" Command="{Binding RegisterEquipmentCommand}"/>
                        <Button Content="Save Changes" Command="{Binding UpdateEquipmentCommand}"/>
                        <Button Content="Clear" Command="{Binding ClearFormCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,8,0,0" Spacing="4">
            <Border IsVisible="{Binding IsUnknownOutcome}" Background="#6B4F00" CornerRadius="4" Padding="8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Refresh State" Command="{Binding LoadCommand}" Margin="8,0,0,0"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="White" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
            <TextBlock Text="{Binding StatusMessage}" Foreground="Orange" TextWrapping="Wrap"
                       IsVisible="{Binding !IsUnknownOutcome}"/>
        </StackPanel>
    </Grid>
</UserControl>
