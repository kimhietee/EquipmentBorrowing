<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="EquipmentBorrowing.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="EquipmentBorrowing.Desktop">

    <Grid ColumnDefinitions="180,*">
    <StackPanel Grid.Column="0" Background="#1e1e1e" Spacing="6" Margin="10">
        <TextBlock Text="Campus Equipment" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
        <Button Content="Equipment" Command="{Binding ShowEquipmentCommand}" HorizontalAlignment="Stretch"/>
        <Button Content="Active Borrowings" Command="{Binding ShowBorrowingsCommand}" HorizontalAlignment="Stretch"/>
    </StackPanel>
    <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="16"/>
</Grid>

</Window>
