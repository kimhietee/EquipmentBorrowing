<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             x:Class="EquipmentBorrowing.Desktop.Views.BorrowingsView"
             x:DataType="vm:BorrowingsViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="Active Borrowings" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <ListBox Grid.Row="1" ItemsSource="{Binding ActiveBorrowings}" SelectedItem="{Binding SelectedBorrowing}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding Id}" Width="40"/>
                        <TextBlock Text="{Binding StudentId}" Width="80"/>
                        <TextBlock Text="{Binding EquipmentId}" Width="80"/>
                        <TextBlock Text="{Binding ExpectedReturnDate}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Margin="0,10,0,0" Spacing="6">
            <Button Content="Return Equipment" Command="{Binding ReturnCommand}" HorizontalAlignment="Stretch"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="Orange"/>
        </StackPanel>
    </Grid>
</UserControl>