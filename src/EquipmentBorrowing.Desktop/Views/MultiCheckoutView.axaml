<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
             xmlns:domain="using:EquipmentBorrowing.Domain"
             x:Class="EquipmentBorrowing.Desktop.Views.MultiCheckoutView"
             x:DataType="vm:MultiCheckoutViewModel">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding LoadCommand}"/>
            <TextBlock Text="Multi-Item Checkout" Classes="heading" Margin="0"/>
        </DockPanel>

        <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,8">
            <TextBlock Text="Loading students and equipment..." IsVisible="{Binding IsLoading}" FontStyle="Italic"/>
            <Border IsVisible="{Binding HasError}" Background="#5A2A27" CornerRadius="4" Padding="8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Retry" Command="{Binding LoadCommand}" Margin="8,0,0,0"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="White" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="*,16,*">
            <Border Grid.Column="0" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="1. Select Student &amp; Return Date" FontWeight="Bold"/>
                    <ComboBox ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}"
                              PlaceholderText="Select student" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="domain:Student">
                                <TextBlock>
                                    <Run Text="{Binding StudentNumber}"/>
                                    <Run Text=" - "/>
                                    <Run Text="{Binding Name}"/>
                                    <Run Text=" (Eligible: "/>
                                    <Run Text="{Binding IsAllowedToBorrow}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="Expected Return Date" FontSize="12" Foreground="Gray"/>
                    <DatePicker SelectedDate="{Binding ExpectedReturnDate}" HorizontalAlignment="Stretch"/>

                    <TextBlock Text="2. Add Equipment Items (at least 2 distinct)" FontWeight="Bold" Margin="0,8,0,0"/>
                    <ComboBox ItemsSource="{Binding CatalogEquipment}" SelectedItem="{Binding EquipmentToAdd}"
                              PlaceholderText="Select equipment item" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="domain:Equipment">
                                <TextBlock>
                                    <Run Text="{Binding Identifier}"/>
                                    <Run Text=" - "/>
                                    <Run Text="{Binding Name}"/>
                                    <Run Text=" (Available: "/>
                                    <Run Text="{Binding IsAvailable}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Add Item to Checkout" Command="{Binding AddItemCommand}" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Padding="12">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Row="0" Text="Selected Checkout Items" FontWeight="Bold" Margin="0,0,0,8"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding SelectedItems}" SelectedItem="{Binding SelectedCheckoutItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="domain:Equipment">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding Identifier}" FontWeight="SemiBold" Width="90"/>
                                    <TextBlock Text="{Binding Name}" Width="180"/>
                                    <TextBlock Text="{Binding IsAvailable, StringFormat='Available: {0}'}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Remove Selected" Command="{Binding RemoveSelectedItemCommand}"/>
                            <Button Content="Clear List" Command="{Binding ClearItemsCommand}"/>
                        </StackPanel>
                        <Button Content="Check Out All Items (Single Transaction)" Command="{Binding CheckoutCommand}" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,10,0,0" Spacing="4">
            <Border IsVisible="{Binding IsUnknownOutcome}" Background="#6B4F00" CornerRadius="4" Padding="8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Refresh State" Command="{Binding LoadCommand}" Margin="8,0,0,0"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="White" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
            <TextBlock Text="{Binding StatusMessage}" Foreground="Orange" TextWrapping="Wrap"
                       IsVisible="{Binding !IsUnknownOutcome}"/>
        </StackPanel>
    </Grid>
</UserControl>
